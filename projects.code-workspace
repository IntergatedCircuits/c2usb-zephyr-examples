{
	"folders": [
		{
			"path": ".",
			"name": "Manifest repository"
		},
		{
			"path": "..",
			"name": "workspace"
		},
		{
			"path": "ble-keyboard"
		},
		{
			"path": "usb-keyboard"
		},
		{
			"path": "usb-mouse"
		},
		{
			"path": "usb-shell"
		}
	],
	"settings": {
		"files.associations": {
			"*.h": "c",
			"*.c": "c",
			"*.hpp": "cpp",
			"*.cpp": "cpp",
			"VERSION": "plaintext"
		},
		"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
		"C_Cpp.workspaceParsingPriority": "high",
		"C_Cpp.autoAddFileAssociations": false,
		"[c]": {
			"editor.defaultFormatter": "ms-vscode.cpptools",
			"editor.formatOnSave": true
		},
		"[cpp]": {
			"editor.defaultFormatter": "ms-vscode.cpptools",
			"editor.formatOnSave": true
		},
		"cmake.configureOnOpen": false,
		"cmake.enableAutomaticKitScan": false,
		"cmake.options.advanced": {
			"build": {
				"statusBarVisibility": "hidden"
			},
			"launch": {
				"statusBarVisibility": "hidden"
			},
			"debug": {
				"statusBarVisibility": "hidden"
			}
		},
		"cmake.useCMakePresets": "always",
		"devicetree.zephyr": "${workspaceFolder:workspace}/zephyr",
		"[json]": {
			"editor.defaultFormatter": "vscode.json-language-features"
		},
		"[jsonc]": {
			"editor.defaultFormatter": "vscode.json-language-features"
		},
		"nrf-connect.applications": [
			"${workspaceFolder}/ble-keyboard",
			"${workspaceFolder}/usb-keyboard",
			"${workspaceFolder}/usb-mouse",
			"${workspaceFolder}/usb-shell"
		],
		"nrf-connect.topdir": "${workspaceFolder:workspace}",
		"nrf-connect.boardRoots": [
			"${workspaceFolder}/"
		],
	},
	"extensions": {
		"recommendations": [
			"nordic-semiconductor.nrf-connect-extension-pack",
			"marus25.cortex-debug",
			"mcu-debug.peripheral-viewer",
			"ms-vscode.vscode-embedded-tools",
			"ms-vscode.vscode-serial-monitor",
			"thecreativedodo.usbip-connect"
		]
	}
}